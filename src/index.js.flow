// @flow

type Reader = <T>(path: string) => Promise<T>;

export type PersistStorage = {
  get: (key: string) => Promise<string | null>,
  set: (key: string, value: string) => Promise<void>,
  remove: (key: string) => Promise<void>,
};

export type PersistConfig = {
  storage: PersistStorage,
  version: string,
  keyPrefix?: string,
  maxAge?: number,
};

export type ReadConfig = {
  reader?: Reader,

  staleWhileMounted?: boolean,
  staleWhileInvalidated?: boolean,
  staleWhileError?: boolean,

  invalidateAge?: number,
};

type StaleReason = 'mounted' | 'invalidated' | 'error';

export type ReadResult<T> = {
  data: T | void,
  error: Error | void,
  stale: boolean,
  staleReason: null | StaleReason,
  receivedAt: null | number,
  invalidate: () => void,
  invalidateExact: (search: string) => void,
  invalidateMatching: (search: string | RegExp) => void,
  mutate: (mutator: (data: T) => T) => void,
  readMore: (path: string, updater: (moreData: T) => T) => void,
  loadingMore: boolean,
  moreError: Error | void,
};

declare export class ApiReadProvider extends React$Component<{
  config: ReadConfig,
  persistConfig?: PersistConfig,
  children: React$Node,
}> {}

declare export function useApiRead<T>(
  path: string | null,
  options?: ReadConfig
): ReadResult<T>;

declare export function useInvalidation(): {
  invalidateExact: (search: string) => void,
  invalidateMatching: (search: string | RegExp) => void,
};

declare export function useMutation(): {
  mutateExact: (search: string, mutator: <T>(data: T) => T) => void,
  mutateMatching: (
    search: string | RegExp,
    mutator: <T>(data: T) => T
  ) => void,
};
